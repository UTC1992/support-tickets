NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Optional legacy fallback if your project still uses anon keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only key for Supabase Auth admin operations. Never use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Runtime connection for the app. In Supabase this is usually the pooler URL.
DATABASE_URL=""

# Direct database connection for Prisma CLI migrations.
DIRECT_URL=""

# Optional. Use only if you configure a separate shadow database.
SHADOW_DATABASE_URL=""
