generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  owner
  admin
  technician

  @@map("app_role")
}

model Tenant {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String          @unique
  isActive     Boolean         @default(true) @map("is_active")
  profiles     Profile[]
  sectors      Sector[]
  technicians  Technician[]
  supportTypes SupportType[]
  tickets      Ticket[]
  history      TicketHistory[]
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("tenants")
}

model PlatformAdmin {
  userId    String   @id @map("user_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("platform_admins")
}

enum TicketStatus {
  pending
  assigned
  in_progress
  completed
  not_completed
  rescheduled
  cancelled

  @@map("ticket_status")
}

enum TicketPriority {
  low
  normal
  high
  urgent

  @@map("ticket_priority")
}

model Profile {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  fullName  String   @map("full_name")
  role      AppRole  @default(technician)
  isActive  Boolean  @default(true) @map("is_active")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, role])
  @@map("profiles")
}

model Sector {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets   Ticket[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("sectors")
}

model Technician {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String?  @unique @map("user_id") @db.Uuid
  name      String
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets   Ticket[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, isActive])
  @@map("technicians")
}

model SupportType {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets   Ticket[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("support_types")
}

model Ticket {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  clientName      String          @map("client_name")
  clientPhone     String?         @map("client_phone")
  clientIp        String?         @map("client_ip")
  address         String?
  sectorId        String?         @map("sector_id") @db.Uuid
  supportTypeId   String?         @map("support_type_id") @db.Uuid
  technicianId    String?         @map("technician_id") @db.Uuid
  status          TicketStatus    @default(pending)
  priority        TicketPriority  @default(normal)
  intakeDate      DateTime        @default(dbgenerated("CURRENT_DATE")) @map("intake_date") @db.Date
  scheduledAt     DateTime?       @map("scheduled_at") @db.Timestamptz(6)
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz(6)
  observation     String?
  technicianNotes String?         @map("technician_notes")
  resultNotes     String?         @map("result_notes")
  sourceSheet     String?         @map("source_sheet")
  sourceRow       Int?            @map("source_row")
  createdBy       String?         @map("created_by") @db.Uuid
  updatedBy       String?         @map("updated_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sector          Sector?         @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  supportType     SupportType?    @relation(fields: [supportTypeId], references: [id], onDelete: SetNull)
  technician      Technician?     @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  history         TicketHistory[]

  @@index([tenantId, status])
  @@index([tenantId, intakeDate(sort: Desc)])
  @@index([status])
  @@index([intakeDate(sort: Desc)])
  @@index([technicianId])
  @@index([sectorId])
  @@index([supportTypeId])
  @@map("tickets")
}

model TicketHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  eventType String   @map("event_type")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([ticketId, createdAt(sort: Desc)])
  @@map("ticket_history")
}
